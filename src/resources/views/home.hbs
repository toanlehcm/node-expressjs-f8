<div class="main-content mt-4">
    <div class="row">
      {{#each courses}}
        <div class="col-sm-6 col-md-4 col-lg-3">
          <div class="card mt-4">
            <a href="/courses/{{this.slug}}">
              <img src="{{this.image}}" class="card-img-top" alt="{{this.image}}">
            </a>
            <div class="card-body">
                <h5 class="card-title">
                  <a href="/courses/{{this.slug}}">{{this.name}}</a>
                </h5>
                <p class="card-text">{{this.description}}</p>
                <a href="#" class="btn btn-primary">Mua khóa học</a>
            </div>
          </div>
        </div>
      {{/each}}
    </div>
</div>