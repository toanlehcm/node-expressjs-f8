<div class="mt-4">
  <h3>My courses</h3>
  
  <table class="table">
    <thead>
      <tr>
        <th scope="col">#</th>
        <th scope="col">Course</th>
        <th scope="col">Level</th>
        <th scope="col">Created at</th>
        <th scope="col"></th>
      </tr>
    </thead>
    <tbody>
      {{#each courses}}
      <tr>
        <th scope="row">{{sum @index 1}}</th>
        <td>{{this.name}}</td>
        <td>{{this.level}}</td>
        <td>{{this.createdAt}}</td>
        <td>
          <a href="/courses/{{this._id}}/edit" class="btn btn-primary">Edit</a>
          <a href="/courses/{{this._id}}/delete" class="btn btn-danger">Delete</a>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>
