<div class="mt-4">
  <div class="mt-4">
    <h3>Trash courses</h3>
    <a href="/me/stored/courses">Back to courses</a>
  </div>
  
  <table class="table">
    <thead>
      <tr>
        <th scope="col">#</th>
        <th scope="col">Course</th>
        <th scope="col">Level</th>
        <th scope="col">Deleted at</th>
        <th scope="col"></th>
      </tr>
    </thead>
    <tbody>
      {{#each courses}}
      <tr>
        <th scope="row">{{sum @index 1}}</th>
        <td>{{this.name}}</td>
        <td>{{this.level}}</td>
        <td>{{this.deletedAt}}</td>
        <td>
          <a href="" class="btn btn-primary btn-restore" data-id="{{this._id}}">Restore</a>
          <button type="button" class="btn btn-danger" data-toggle="modal" data-target="#delete-course-modal" data-id="{{this._id}}">
            Permanently Delete
          </button>
        </td>
      </tr>
      {{else}}
      <tr>
        <td colspan="5" class="text-center">
          Empty trash.
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>

<form name="delete-course-form" method="POST"></form>
<form name="restore-course-form" method="POST"></form>

<!-- Delete course modal -->
<div class="modal fade" id="delete-course-modal" tabindex="-1" aria-labelledby="delete-course-modal-label" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="delete-course-modal-label">Modal confirm</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        This action can't be undone.
        <br>
        Are you sure you want to permanently delete this course?
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
        <button id="btn-delete-course" type="button" class="btn btn-danger">Permanently Delete</button>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var courseIdForceDelete;
    var deleteForm = document.querySelector('form[name="delete-course-form"]');
    var restoreForm = document.querySelector('form[name="restore-course-form"]');
    
    var btnDelete = document.getElementById('btn-delete-course');
    var btnRestore = document.querySelector('.btn-restore');
    
    $('#delete-course-modal').on('show.bs.modal', function (event) {
      var button = $(event.relatedTarget) // Button that triggered the modal
      courseIdForceDelete = button.data('id') // Extract info from data-* attributes
    })

    btnDelete.onclick = function() {
      deleteForm.action = '/courses/' + courseIdForceDelete + '/force?_method=DELETE';
      deleteForm.submit();
    }

    btnRestore.onclick = function(e) {
      e.preventDefault();
      var courseId = this.dataset.id;
      restoreForm.action = '/courses/' + courseId + '/restore?_method=PATCH';
      restoreForm.submit();
    }
  })
</script>